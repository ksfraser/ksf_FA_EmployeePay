{
    "name": "ksfraser/ksf-fa-employeepay",
    "description": "Canadian employee wage/payroll journal entry module for FrontAccounting",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.3",
        "ksfraser/famock": "dev-main",
        "ksfraser/ksf-modules-dao": "dev-main",
        "ksfraser/exceptions": "dev-main"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\EmployeePay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ksfraser\\FrontAccounting\\EmployeePay\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
